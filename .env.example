# Enchilada — self-host configuration.
# Copy this file to `.env` and edit values as needed. Every key here has a
# sensible default in docker-compose.yml — you only need to set the ones you
# want to change.
#
# Compose reads this file for VARIABLE INTERPOLATION only: a key here reaches a
# container only because docker-compose.yml names it as `${KEY:-default}`. That
# is why this file and the compose file must be kept in step — a knob the
# compose file never names is unreachable no matter what you put here.

# --- Image version ----------------------------------------------------------
# The immutable tag of the enchilada-core-* images this stack pulls. Bump
# this to upgrade; consult the CHANGELOG at
# https://github.com/mimagic/enchilada/releases before doing so.
ENCHILADA_TAG=v0.20.1

# --- Ports (host-side; container internals are unchanged) -------------------
# Pick anything unused. Defaults are chosen to NOT clash with a dev machine
# already running Postgres/Redis on their standard ports.
API_PORT=3100
POSTGRES_PORT=5442
REDIS_PORT=6390
RAG_PORT=9631
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
OLLAMA_PORT=11434            # only used with --profile ollama
# Host port for the deterministic extractor sidecar. LEAVE BLANK: an empty value
# makes Docker pick an ephemeral port, which is what allows
# `--profile deterministic up -d --scale extractor=N`. Set it only when you run a
# single replica and want a fixed port to curl.
EXTRACT_PORT=

# --- Network exposure -------------------------------------------------------
# Which host interface the INTERNAL services publish on: postgres, redis, rag,
# extractor, minio and the bundled ollama. Default 127.0.0.1 (loopback only).
# `api` is deliberately NOT covered — it is the one service with authentication
# and the one you are meant to reach from another machine.
#
# ⚠️ Setting BIND_ADDR=0.0.0.0 exposes, to every host that can route to this
# machine: an unauthenticated Redis, Postgres with the password below, the RAG
# admin endpoints (protected only by RAG_ADMIN_TOKEN), the MinIO console, an
# Ollama that will answer anyone's prompt, and — with the deterministic profile —
# an /extract endpoint with NO authentication at all. Do that only on a network
# you control, and change every secret in this file first.
BIND_ADDR=127.0.0.1

# --- Secrets (CHANGE THESE FOR ANYTHING PAST A LOCAL TRIAL) -----------------
# Postgres superuser password. Used by both databases (proxy + lightrag).
POSTGRES_PASSWORD=enchilada
# MinIO admin credentials. The api/worker use these to reach the blob store.
MINIO_ROOT_USER=enchilada
MINIO_ROOT_PASSWORD=enchilada-minio
# Session cookie signing secret. LEAVE BLANK to auto-generate on first boot
# (persisted under a container volume). Set explicitly for reproducible sessions
# across container recreates.
SESSION_SECRET=
# Admin token for the RAG service's internal admin endpoints (workspace
# provisioning, cache/graph maintenance). ⚠️ The value below is the PUBLISHED
# default — anyone who can reach the rag port knows it. Change it before you
# change BIND_ADDR, and change it for anything shared.
RAG_ADMIN_TOKEN=selfhost-admin-token

# --- Blob store -------------------------------------------------------------
# The bucket name inside MinIO. Created automatically on first boot.
BLOB_BUCKET=enchilada-blobs

# --- Pipeline telemetry -----------------------------------------------------
# Per-phase ingest events (Redis Streams → the pipeline waterfall in the
# console). Default on. Both the api and the rag service read this; turning it
# off turns off publishing AND consuming.
# ⚠️ With this on, the rag service REQUIRES REDIS_URL and refuses to boot
# without it. The compose file sets REDIS_URL for you — if you write your own
# manifest, set both or neither.
ENABLE_PIPELINE_TELEMETRY=true

# --- LLM / extraction tuning ------------------------------------------------
# How long the RAG engine waits for a single LLM call before timing out
# (seconds). The default of 900 is generous — the bundled local Ollama on CPU
# is slow enough that shorter timeouts trip during entity extraction.
LLM_TIMEOUT=900
# Extraction runs deterministically at temperature 0.0 by default so the same
# document yields a stable knowledge graph. Raise this only if you find a weak
# local model looping during extraction.
RAG_EXTRACT_TEMPERATURE=0.0

# PRD-35 deterministic knowledge extractor (opt-in). Set to 1 AND start the stack with
# `--profile deterministic` to run the self-contained extractor sidecar → same document
# produces a byte-identical knowledge graph, independent of your LLM. Needs ~7GB RAM.
# READ docs/deterministic-extractor.md FIRST if your host is a NAS or any other
# CPU-only box: this tier costs minutes of CPU per chunk, not seconds.
RAG_EXTRACT=0
# Where a chunk is POSTed for extraction. Defaults to the in-stack sidecar.
# ⚠️ /extract has NO authentication. Pointing this at another machine ("remote
# extractor" mode) is supported and is the right answer for a large corpus, but
# only over a network you fully control — same host, a private VLAN, or a
# Tailscale/WireGuard address. Never across the open internet.
RAG_EXTRACT_URL=http://extractor:9640/extract

# Recursive (heading-aware) chunking. Default F keeps the classic 1200-token window.
# Set RAG_CHUNK_STRATEGY=R for ~300-token chunks that fit the deterministic extractor's
# 384-token window — materially more entities/relations per document, still fully
# deterministic. Recommended together with RAG_EXTRACT=1. (Affects only newly ingested
# documents; existing graphs are untouched.)
# ⚠️ R multiplies the number of chunks per document, and with RAG_EXTRACT=1 every
# chunk is a separate CPU decode — budget the ingest time accordingly (README →
# "Hardware sizing").
RAG_CHUNK_STRATEGY=F
RAG_CHUNK_TOKEN_SIZE=300
RAG_CHUNK_OVERLAP=40

# --- Determinism & claim store (PRD-35) -------------------------------------
# ⚠️ The first three are ABLATION flags, not tuning. They are ON because that IS
# the product behaviour: deterministic merge is what makes "same document, same
# graph" true, and grounding validation is what keeps hallucinated claims out of
# the canonical set. Setting either to 0 silently restores stock LightRAG's
# stochastic LLM description-summary merge. Change them only to reproduce a
# measurement.
RAG_DETERMINISTIC_MERGE=1
RAG_CLAIM_STORE=1
RAG_CLAIM_VALIDATION=1
# The next two are per-deployment POLICY, and the reason this section exists.
# Confidence threshold τ: a claim below τ is labelled "conjecture" (still
# visible and auditable), at/above it "canonical". It is a read-time projection —
# raising τ reclassifies your whole history without touching any data.
RAG_CONFIDENCE_THRESHOLD=0.0
# Optional per-tenant predicate whitelist (comma-separated). Empty = every
# predicate is accepted (validation skipped).
RAG_PREDICATE_VOCAB=
# The separate rule/gate L1 extraction tier. NOT required for RAG_EXTRACT.
RAG_EXTRACT_LAYER1=0

# --- Low-powered host (NAS-class CPU) ---------------------------------------
# The defaults below are already tuned for a slow host. This section exists so
# you can find them, and so you know which way to move them on a fast one.
#
# Per-chunk ceiling for one /extract call (seconds). THE most important knob on
# a slow host: the shipped extractor is a single-thread fp32 model on CPU,
# measured at 83-188s per ~300-token German chunk on a NAS.
# ⚠️ This is a BUDGET, not just a timeout:
#     (1 + RAG_EXTRACT_MAX_RETRIES) x RAG_EXTRACT_TIMEOUT_S + backoff  <  LLM_TIMEOUT x 2
# LLM_TIMEOUT x 2 is LightRAG's own worker ceiling. Breach it and the worker
# kills the chunk from a layer that cannot report why — which is the silent hole
# these settings exist to close. Defaults: 2 x 600 + ~2s = 1202s vs 1800s.
# If your host genuinely needs longer per chunk, raise LLM_TIMEOUT with it.
RAG_EXTRACT_TIMEOUT_S=600
# Retries AFTER the first attempt, with exponential backoff (clamped 0..3).
RAG_EXTRACT_MAX_RETRIES=1
# fail | empty. `fail` (default) makes an extractor timeout/503/error FAIL the
# document. `empty` restores the old best-effort behaviour, which is what
# produced graphs that looked complete and were not — see
# docs/runbooks/repair-empty-extractions.md.
# ⚠️ Only read from the release AFTER v0.19.0. On a stack still pinned to
# ENCHILADA_TAG=v0.19.0 this key has no effect and the engine behaves as
# `empty`, whatever you set here.
RAG_EXTRACT_ON_FAILURE=fail
# Chunks extracted CONCURRENTLY per tenant. 1 = each chunk gets the whole CPU and
# an honest latency. LightRAG's own default is 4, which on a single-thread
# extractor makes all four finish ~4x later and cross the timeout together.
# Raise it in step with EXTRACT_CONCURRENCY below, and only on a machine with the
# memory bandwidth to use it. If you use a fast HOSTED LLM (RAG_EXTRACT=0), 4.
EXTRACT_MAX_ASYNC_LLM=1
# Embedding calls in flight per tenant (LightRAG default 8). This is the queue
# ingest and query genuinely share; a shallower queue is what keeps a query
# answering while an ingest runs.
EMBEDDING_FUNC_MAX_ASYNC=2
# Fallback concurrency for LLM roles with no override of their own (query,
# keyword). Left at LightRAG's default — lowering it slows queries.
MAX_ASYNC_LLM=4
# Documents extracted in parallel per tenant. Lower to 1 when a single document
# already saturates the CPU.
MAX_PARALLEL_INSERT=3
# --- RAG-facing time budgets (ms) -------------------------------------------
# These four are the code defaults from api/src/lib/rag-fetch.ts, read at call
# time. Until now they were decoration: Bun's fetch keeps an undocumented 300s
# idle floor, so ANY budget above 300s aborted at 300s. That floor is gone, so
# these are real ceilings — and each one is also how long a single bad request
# occupies its caller. Raise on a slow host, lower for a fast hosted stack.
#
# Control-plane calls (document list, job-status poll, admin lookups).
RAG_PROXY_TIMEOUT_MS=120000
# Answer generation; a mode=mix query is two LLM calls plus embeddings.
# ⚠️ Stay below the chat surface's CHAT_TOOL_TIMEOUT_MS (300000): above it the
# api logs a ladder warning at boot and the extra budget is unreachable, because
# chat abandons the tool call first.
RAG_QUERY_TIMEOUT_MS=240000
# Corpus/document-wide maintenance: re-embed, purge, destructive replace.
RAG_BULK_TIMEOUT_MS=600000
# One document through extract+merge. 15 min is a RAISE over what actually
# happened before (the 1800000 this file used to carry never survived Bun's 300s
# floor), and it is deliberately not 30 min: BullMQ retries an ingest 3x, so this
# value x3 is how long one permanently broken document pins a worker slot while
# every other ingest queues behind it — 45 min at 900000, 90 min at 1800000.
RAG_INGEST_TIMEOUT_MS=900000

# --- Other worker-side ceilings (ms) ----------------------------------------
PARSER_TIMEOUT_MS=1800000
DECOMPOSE_TIMEOUT_MS=1800000
# Chat turns processed at once. 1 stops a chat turn from competing with an ingest.
CHAT_WORKER_CONCURRENCY=2

# --- Deterministic extractor sidecar (--profile deterministic) --------------
# Which extractor image. ⚠️ ONE image per deployment, and the SAME image on every
# replica: the int8 build is numerically != fp32 and has its own reproducible
# graph hash. int8 is ~4x faster but measured 25% fewer entities and mangled
# identifiers on German text — see docs/deterministic-extractor.md before using it.
EXTRACTOR_IMAGE=ghcr.io/mimagic/enchilada-core-extractor
# Memory ceiling for the sidecar. ~7 GB resident for the fp32 weights, plus
# ~0.3 GB per additional in-flight request. Bounds an over-set concurrency to an
# OOM-killed sidecar instead of an OOM-killed host.
EXTRACTOR_MEM_LIMIT=10g
# Requests decoded at once. `auto` = clamp(CPU quota, 1, 4). Decode is memory-
# BANDWIDTH bound, so on a single-channel NAS more workers buy ~nothing; on a
# dual-channel desktop they buy 3-5x. See README → "Hardware sizing".
EXTRACT_CONCURRENCY=auto
# Requests allowed to WAIT before the server answers 503 + Retry-After.
# `auto` = 2x concurrency. Shallow on purpose: a deeper queue on a
# bandwidth-bound host does not raise throughput, it just turns a fast 503 the
# client can back off from into a slow client-side timeout it cannot.
EXTRACT_QUEUE_MAX=auto
# Absolute per-request deadline in seconds. Blank = derived from the measured
# decode rate. That derivation self-scales, so it does NOT catch a host that is
# uniformly slow — on one of those, set this to your RAG_EXTRACT_TIMEOUT_S.
EXTRACT_DEADLINE_S=
# Decode cap. ⚠️ Do NOT raise it — measured, 512 and 1024 decode to byte-identical
# output. Lowering it is a legitimate brake on a very slow host, but it changes
# your reproducible graph hash.
EXTRACT_MAX_NEW_TOKENS=512
# ⚠️ DETERMINISM FENCE. Intra-op threads PER request. Above 1 the floating-point
# reduction order inside a matmul changes, so the same document can produce a
# different graph — the product's core promise stops holding. The server refuses
# to start above 1 unless EXTRACT_ALLOW_NONDETERMINISTIC=1 is also set. For
# throughput, raise EXTRACT_CONCURRENCY or add replicas instead.
EXTRACT_TORCH_THREADS=1
EXTRACT_ALLOW_NONDETERMINISTIC=0

# --- Repair / maintenance ---------------------------------------------------
# Deleting a document normally KEEPS its extraction cache, so re-ingesting
# identical text replays the same extraction instead of re-rolling the LLM's
# dice. The cost is that a cached FAILED extraction also survives delete +
# re-upload, and nothing in the UI clears it.
# Set to true when RAG_EXTRACT=1 (the deterministic extractor has no dice to
# re-roll) if you need delete + re-upload to genuinely redo the extraction.
# See docs/runbooks/repair-empty-extractions.md.
DELETE_LLM_CACHE_ON_DOC_DELETE=false

# --- Optional: bundled Ollama profile ---------------------------------------
# Only used with `docker compose --profile ollama up -d`. The one-shot
# ollama-pull container fetches these models on first boot.
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Vision model, pulled only by the GPU overlay (docker-compose.gpu.yml).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
